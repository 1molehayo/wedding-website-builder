# Demo development environment — copy to `.env.demo` (gitignored).
# Used ONLY by `pnpm dev:demo` and demo Supabase scripts.
# Never falls back to `.env` or `.env.local`.

# Local Demo Supabase stack (after `pnpm supabase:demo:start`):
#   API http://127.0.0.1:54331 — copy keys from `pnpm supabase:demo:status`
# For day-to-day `pnpm dev:demo`, keep the local URL below.
VITE_SUPABASE_URL=http://127.0.0.1:54331

# Browser-safe publishable key (local status or demo dashboard)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key (local status or demo dashboard)
SUPABASE_SECRET_KEY=

# Demo **cloud** project ref for `pnpm db:demo:link` / `db:demo:push` (while VITE_* stays local).
# Accepts bare ref, https://<ref>.supabase.co, or dashboard URL
#   https://supabase.com/dashboard/project/<ref>
# Must be a different project than Regular production.
# DEMO_SUPABASE_PROJECT_REF=

# Super-admin bootstrap for demo cloud (server-only). Optional for local Mailpit.
# PRODUCTION_SUPER_ADMIN_EMAIL=owner@example.com
PRODUCTION_SUPER_ADMIN_EMAIL=

# Demo app origin (must match vite --port 3001)
APP_URL=http://localhost:3001

# External email disabled by default for demo
EMAIL_DELIVERY_ENABLED=false

# Optional — leave empty for demo
RESEND_API_KEY=
# RESEND_FROM_EMAIL=Demo <noreply@yourdomain.com>
# GOOGLE_MAPS_API_KEY=

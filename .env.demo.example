# Demo development environment (used by `pnpm dev:demo`).
# Copy to `.env.demo` (gitignored). Used ONLY by demo scripts.
# Never falls back to `.env` or `.env.local`.
# Never put Regular/production credentials here.
#
# Local Demo Supabase API: http://127.0.0.1:54331
# After `pnpm supabase:demo:start`, copy keys from `pnpm supabase:demo:status`.

# --- Supabase ---
# Keep local for day-to-day `pnpm dev:demo` (Regular local uses 54321).
VITE_SUPABASE_URL=http://127.0.0.1:54331

# Browser-safe key (Settings → API Keys → Publishable, or local status output)
# Replaces the legacy "anon" key. Safe in the client; respects RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only key (Settings → API Keys → Secret, or local status output)
# Replaces the legacy "service_role" key. Never expose to the browser; bypasses RLS.
SUPABASE_SECRET_KEY=

# --- Demo cloud link ---
# For `pnpm db:demo:link` / `db:demo:push` while VITE_* stays local above.
# igbeyawowa-demo project ref from:
#   https://supabase.com/dashboard/project/<ref>
# Also accepts https://<ref>.supabase.co or the full dashboard URL.
# Must be a different project than Regular production in `.env`.
DEMO_SUPABASE_PROJECT_REF=

# --- Auth bootstrap ---
# Server-only: email(s) allowed to bootstrap /admin as super_admin on first cloud login.
# Comma-separated list is supported (e.g. owner@example.com,co-owner@example.com).
# Leave unset for local Mailpit (uses superadmin@supabase.com).
# Example placeholder only — never commit a real address:
# PRODUCTION_SUPER_ADMIN_EMAIL=owner@example.com,co-owner@example.com
PRODUCTION_SUPER_ADMIN_EMAIL=

# --- App ---
# Local: must match vite --port 3001.
# Cloud demo Vercel project sets https://demo.igbeyawowa.app
APP_URL=http://localhost:3001

# --- Email ---
# External email disabled by default for local demo (logs instead).
# Set true only when testing Resend against the demo cloud.
EMAIL_DELIVERY_ENABLED=false

# App transactional email via Resend SDK (guest RSVP invites, photo shares,
# admin invites, support). NOT the same path as Auth OTP.
# Demo Auth OTP still uses Resend via Supabase custom SMTP when configured.
RESEND_API_KEY=

# From: for app-sent mail (verified domain). Optional for local demo.
# RESEND_FROM_EMAIL=Igbeyawowa Demo <noreply@demo.igbeyawowa.app>
RESEND_FROM_EMAIL=

# --- Cron ---
# Server-only: Bearer token for /api/cron/* (registry reminders).
# Optional for local demo; set on the demo Vercel project if cron is enabled.
# CRON_SECRET=
CRON_SECRET=

# --- Maps ---
# Google Places Autocomplete (New) — server-only. Enable "Places API (New)"
# in Google Cloud. Billing must be enabled; Google’s monthly credit usually
# covers light admin usage. Restrict the key by IP/app if possible.
# If unset (or Google fails), venue search falls back to free Photon/OSM.
GOOGLE_MAPS_API_KEY=

# --- Registry FX ---
# No env var required. Live rates use public Frankfurter + open.er-api.com.

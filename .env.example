# Regular development environment (used by `pnpm dev`).
# Prefer day-to-day local overrides in `.env.local` (gitignored).
# Demo uses a separate file — see `.env.demo.example` and `pnpm dev:demo`.
# Never put demo credentials here.
#
# Cloud / production Supabase (Vercel + debugging cloud from your machine).
# For local Mailpit/OTP, use `.env.local` (overrides these on `pnpm dev`).

# --- Supabase ---
# Project URL (Settings → API)
VITE_SUPABASE_URL=

# Browser-safe key (Settings → API Keys → Publishable)
# Replaces the legacy "anon" key. Safe in the client; respects RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only key (Settings → API Keys → Secret)
# Replaces the legacy "service_role" key. Never expose to the browser; bypasses RLS.
# Local: JWT service_role from `pnpm status` also works in `.env.local`.
SUPABASE_SECRET_KEY=

# --- Auth bootstrap ---
# Server-only: email(s) allowed to bootstrap /admin as super_admin on first cloud login.
# Comma-separated list is supported (e.g. owner@example.com,co-owner@example.com).
# Required whenever VITE_SUPABASE_URL points at a non-local project (production / Vercel).
# Do not use a VITE_ prefix. Leave unset for local Mailpit (uses superadmin@supabase.com).
# Example placeholder only — never commit a real address:
# PRODUCTION_SUPER_ADMIN_EMAIL=owner@example.com,co-owner@example.com
PRODUCTION_SUPER_ADMIN_EMAIL=

# --- App ---
# Public app origin for links in guest/admin emails (defaults to http://localhost:3000).
APP_URL=http://localhost:3000

# --- Email ---
# Optional: set to false to skip outbound app emails (logs instead).
# EMAIL_DELIVERY_ENABLED=false
EMAIL_DELIVERY_ENABLED=

# App transactional email via Resend SDK (guest RSVP invites, photo shares,
# admin invites, support). NOT the same path as Auth OTP.
# Production Auth OTP still uses Resend via Supabase custom SMTP (Dashboard).
RESEND_API_KEY=

# From: for app-sent mail (verified domain). Defaults to Resend onboarding sender.
# RESEND_FROM_EMAIL=Igbeyawowa <noreply@yourdomain.com>
RESEND_FROM_EMAIL=

# --- Cron ---
# Server-only: Bearer token for /api/cron/* (Vercel Cron sends it automatically
# when this env var is set). Generate a long random string for production.
# CRON_SECRET=
CRON_SECRET=

# --- Maps ---
# Google Places Autocomplete (New) — server-only. Enable "Places API (New)"
# in Google Cloud. Billing must be enabled; Google’s monthly credit usually
# covers light admin usage. Restrict the key by IP/app if possible.
# If unset (or Google fails), venue search falls back to free Photon/OSM.
GOOGLE_MAPS_API_KEY=
